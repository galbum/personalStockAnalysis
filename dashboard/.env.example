# Copy to .env and fill in. The dashboard auto-loads this file.

# Required for the analyst narrative + Claude Design deck prompt.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default Claude model (use one your key supports).
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional: Financial Modeling Prep key for deep history (8-12 quarters + ~5
# fiscal years). Without it the dashboard falls back to yfinance (~5 quarters).
FMP_API_KEY=
